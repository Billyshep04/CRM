APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Hosting provisioning fails safe. Keep mock until WHM sync and duplicate checks are verified.
HOSTING_PROVISIONING_MODE=mock
ALLOW_HOSTING_PROVISIONING=false
HOSTING_TERMINATION_MODE=mock
ALLOW_HOSTING_TERMINATION=false
HOSTING_WORDPRESS_ADMIN_USERNAME=webstamp_admin
HOSTING_WORDPRESS_ADMIN_EMAIL=
HOSTING_SSH_PORT=722
# Required for live provisioning. Use the verified SHA256 fingerprint for the configured Krystal SSH host.
HOSTING_SSH_HOST_FINGERPRINT=
HOSTING_DNS_RETRY_MINUTES=10
HOSTING_SSL_RETRY_MINUTES=10
HOSTING_DISK_WARNING_PERCENT=80
HOSTING_DISK_CRITICAL_PERCENT=92
HOSTING_BACKUP_WARNING_HOURS=48

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
WEBSITE_FAILURE_THRESHOLD=2
WEBSITE_MINIMUM_UPTIME_CHECKS=6
WEBSITE_AVAILABILITY_STALE_MINUTES=30
WEBSITE_SSL_STALE_HOURS=36
WEBSITE_WORDPRESS_STALE_HOURS=8
WEBSITE_HOSTING_STALE_HOURS=8
WEBSITE_PERFORMANCE_STALE_HOURS=48
WEBSITE_BACKUP_STALE_HOURS=48
DB_QUEUE_RETRY_AFTER=240

LEAD_DISCOVERY_PROVIDER=google_places
LEAD_DISCOVERY_QUEUE=discovery
LEAD_DISCOVERY_RUN_SYNCHRONOUSLY=false
LEAD_DISCOVERY_AUTO_AUDIT=true
AGENCY_ADMIN_EMAIL=info@web-stamp.co.uk
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_TIMEOUT=20

WEBSITE_AUDIT_QUEUE=audit
WEBSITE_AUDIT_TIMEOUT=15
WEBSITE_AUDIT_CONNECT_TIMEOUT=5
WEBSITE_AUDIT_MAX_REDIRECTS=8
WEBSITE_AUDIT_MAX_BODY_BYTES=5000000
WEBSITE_AUDIT_MAX_LINKS=50
WEBSITE_AUDIT_ENFORCE_PUBLIC_NETWORKS=true
INVOICES_AUTO_SEND_RECURRING=true

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
